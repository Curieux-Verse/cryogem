# Every key here is OPTIONAL. The system must run with an empty .env, degrading
# gracefully: a missing key logs a WARN and marks the affected block unavailable.
# It must never crash. See IMPLEMENTATION_SPEC.md §4.2.
#
# NEVER commit a filled-in .env. In CI these live in GitHub Actions secrets only.

# --- Market / fundamentals ---
COINGECKO_API_KEY=
COINALYZE_API_KEY=

# --- Attention (Tier 2) ---
LUNARCRUSH_API_KEY=

# --- News (Tier 3 — journal labelling only, never a trigger) ---
CRYPTOPANIC_AUTH_TOKEN=

# --- Storage: Turso (libSQL). If unset, the system uses local sqlite3. ---
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Notification only. No interactive commands, no execution. ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Monitoring (healthchecks.io dead-man switch UUIDs) ---
HEALTHCHECK_DAILY=
HEALTHCHECK_HOURLY=
# One Pulse hour scored (collect-hourly `pulse` job). Optional: unset = skipped.
HEALTHCHECK_PULSE=
HEALTHCHECK_JOURNAL=
HEALTHCHECK_SCREEN=
HEALTHCHECK_SUPPLY=
HEALTHCHECK_SITE=

# --- Backup. Without it `backup` publishes no release asset: on a public repo
# a release asset is public, and the dump is the whole database (D-067). ---
BACKUP_PASSPHRASE=
