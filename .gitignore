# Secrets — NEVER commit
.env
.env.local
*.pem

# Databases — see IMPLEMENTATION_SPEC §1.4.5 / §18.9: never commit the DB.
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Local data. NOTE: data/public/ IS committed -- the site reads it, and the
# push to data/public/** is what triggers build-site.yml.
#
# It must be `data/*`, NOT `data/`. Git does not descend into an excluded
# DIRECTORY, so a trailing-slash exclude makes every later negation
# unreachable: `git check-ignore -v data/public/latest.json` reported
# `.gitignore:14: data/`. The publish workflow would have found nothing to
# commit, build-site would never have fired, and the dashboard would have sat
# at its first deploy indefinitely -- with no error anywhere.
data/*
!data/public/
# Pulse is baked hourly inside build-site and deployed WITHOUT a commit (PLAN
# section 6): 24 data commits a day would bloat a permanent history. publish.yml
# commits data/public/**, so this file must be ignored explicitly. A file, not a
# directory, so the negation above still reaches everything else.
data/public/pulse.json

# Logs
logs/
*.log

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage
.coverage.*

# Node / web
node_modules/
web/dist/
web/.vite/

# OS / editors
.DS_Store
Thumbs.db
.idea/
.vscode/

# Credential dumps. A token pasted into a scratch file is one `git add -A`
# away from a public commit, and this repo is public.
turso_key.txt
*_key.txt
*_token.txt
*.key
secrets.json
pat.txt
*pat*.txt
*.pat

# Agent worktrees and local Claude Code state. Never committed: the worktrees
# are full checkouts of this repo.
.claude/
